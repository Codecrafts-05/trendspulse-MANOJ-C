from pathlib import Path

try:
    import pandas as pd
except ImportError as exc:
    raise SystemExit("pandas is required. Install it with: pip install pandas") from exc

base_dir = Path(__file__).resolve().parent
file_path = base_dir / "data" / "trends_20260927.json"
output_path = base_dir / "data" / "trends_clean.csv"

if not file_path.exists():
    raise FileNotFoundError(f"Input file not found: {file_path}")

# Read the JSON file. If the file is a nested JSON payload, normalize it.
df = pd.read_json(file_path)
if not isinstance(df, pd.DataFrame):
    df = pd.json_normalize(df)

print("Loaded", len(df), "stories")

# Keep consistent column names across file variations.
if "num_comment" in df.columns and "num_comments" not in df.columns:
    df = df.rename(columns={"num_comment": "num_comments"})

# Remove duplicate stories using post_id when available.
if "post_id" in df.columns:
    df = df.drop_duplicates(subset="post_id")

print("After removing duplicates:", len(df))

# Remove rows where important fields are missing.
required_cols = [col for col in ["post_id", "title", "score"] if col in df.columns]
if required_cols:
    df = df.dropna(subset=required_cols)

print("After removing nulls:", len(df))

# Convert score and num_comments to integers.
for col in ["score", "num_comments"]:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")

valid_cols = [col for col in ["score", "num_comments"] if col in df.columns]
if valid_cols:
    df = df.dropna(subset=valid_cols)

for col in ["score", "num_comments"]:
    if col in df.columns:
        df[col] = df[col].astype(int)

# Remove stories with score below 5.
if "score" in df.columns:
    df = df[df["score"] >= 5]

print("After removing low scores:", len(df))

# Remove extra spaces from titles.
if "title" in df.columns:
    df["title"] = df["title"].astype(str).str.strip()

# Save cleaned data as CSV.
output_path.parent.mkdir(parents=True, exist_ok=True)
df.to_csv(output_path, index=False)

print("Saved", len(df), "rows to", output_path)

# Show number of stories in each category.
if "category" in df.columns:
    print("\nStories per category:")
    print(df["category"].value_counts())
else:
    print("\nNo category column found in cleaned data.")